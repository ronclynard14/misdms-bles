# MISDMS-BLES Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="mysql://user:password@localhost:3306/misdms_bles"

# ============================================
# Authentication
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
JWT_SECRET="your-jwt-secret-change-this-in-production"

# ============================================
# Email Configuration (DISABLED BY DEFAULT)
# ============================================
# Set to "true" to enable email sending
EMAIL_ENABLED=false

# Email Provider: "none", "smtp", "sendgrid", "mailtrap"
# none: Logs emails to console (development)
# smtp: Generic SMTP server (e.g., Gmail, custom servers)
# sendgrid: SendGrid API (recommended for production)
# mailtrap: Mailtrap (perfect for testing - captures emails)
EMAIL_PROVIDER=none

# From email address
EMAIL_FROM="noreply@school.edu"
EMAIL_FROM_NAME="MISDMS"

# ============================================
# SMTP Configuration (for EMAIL_PROVIDER=smtp or mailtrap)
# ============================================
# Gmail Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# Mailtrap Example (for testing):
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# ============================================
# SendGrid Configuration (for EMAIL_PROVIDER=sendgrid)
# ============================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=info

# School Information (for email templates)
SCHOOL_NAME="Mabini Elementary School"
SCHOOL_WEBSITE="https://school.edu"
SCHOOL_EMAIL="info@school.edu"

# ============================================
# External Services (Optional)
# ============================================
# AWS S3 for file uploads
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=ap-southeast-1
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key

# ============================================
# Security
# ============================================
# CORS allowed origins
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Session configuration
SESSION_MAX_AGE=86400
SECURE_COOKIES=false

# ============================================
# Analytics & Monitoring
# ============================================
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn

# Google Analytics
GOOGLE_ANALYTICS_ID=G-your-ga-id

# ============================================
# Feature Flags
# ============================================
ENABLE_ANALYTICS=true
ENABLE_ALERTS=true
ENABLE_BACKUPS=true
